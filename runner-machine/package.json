{
  "name": "fleet-runner-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet Runner machine agent: turns a laptop or desktop into a device the collector can send work to.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
