<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- vantage reports which transport carried each timing (wifi / cellular /
         ethernet). Without this the workload can only ever say "unknown", and
         a latency figure with no idea what carried it is not comparable to
         anything. Normal permission: granted at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Fleet devices are dedicated hardware: exempting the agent from doze
         keeps beacons and the agent loop alive on battery (observed: Samsung
         doze silenced the runner within minutes of screen-off on battery). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- One APK, every Android shape.
         =====================================================================
         This agent already ran on a TV stick, a headset and a watch: it is a
         foreground service and a text field, and none of that needs a phone.
         What stopped it was packaging, not code. Each declaration below removes
         one reason an installer or a launcher would refuse it.

         A television has no touchscreen, and the Play Store and several TV
         launchers treat `android.hardware.touchscreen` as required-by-default
         and filter the app out entirely. Same for the faketouch fallback. The
         phones are unaffected: declaring a feature not required never removes
         it from a device that has one. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <!-- A TV also has no camera, no telephony, no GPS and often no microphone.
         None of these are used by the runner; they are declared not-required so
         that nothing downstream infers them from a permission. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Leanback is what a TV launcher looks for. Not required, because
         requiring it would hide the app from every phone on the shelf. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Declared so a Wear device's launcher lists the app. Not required, for
         the same reason. -->
    <uses-feature android:name="android.hardware.type.watch" android:required="false" />

    <application
        android:label="Fleet Runner"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:usesCleartextTraffic="true">
        <!-- Cleartext is deliberate: the collector speaks plain HTTP and is only
             reachable inside the Tailscale mesh / adb reverse. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- A TV launcher shows only activities carrying LEANBACK_LAUNCHER.
                     Without this line the APK installs onto a Fire TV or a Google
                     TV perfectly well and then cannot be started from the remote,
                     which reads as "it does not work on TV" and is really "there
                     is no icon". Both categories on one filter, so the same
                     activity is the entry point everywhere rather than there
                     being a TV build and a phone build. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RunnerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
