<?xml version="1.0" encoding="utf-8"?>
<!-- A field that reads as a row in a card rather than as a boxed input: the
     underline is the only affordance, in the same line colour as everything
     else, and it goes accent while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:top="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/fleet_accent" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/fleet_line" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
