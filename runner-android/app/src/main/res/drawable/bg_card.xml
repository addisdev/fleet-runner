<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard's .panel, at phone scale: a larger radius than the web's 8dp
     because a card that fills a phone's width needs a corner you can see. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/fleet_panel" />
    <stroke android:width="1dp" android:color="@color/fleet_line" />
    <corners android:radius="16dp" />
</shape>
