{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleet",
  "version": "0.5.0",
  "identifier": "com.addisdev.fleet-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Fleet",
        "url": "index.html",
        "width": 460,
        "height": 620,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "fleet",
      "iconPath": "icons/trayTemplate.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fleet"],
    "resources": {
      "resources/fleet": "fleet"
    },
    "category": "DeveloperTool",
    "shortDescription": "A device lab you can send work to",
    "longDescription": "Menu-bar shell around the fleet CLI: role switches, the dashboard, and a notification when a component gives up.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {}
}
